// REVIEW DRAFT: not used by the application. See README.md in this directory.
// RegistrationStatus values and convenience defaults are provisional.
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AcademicField {
  COMPUTER_SCIENCE
  BUSINESS_MGMT
  ENGINEERING_ROBOTICS
  HEALTHCARE_BIOTECH
  ARTS_DESIGN
  LAW_SOCIAL_SCIENCES
  ENVIRONMENT_ARGO
}

enum OpportunityFormat {
  IN_PERSON
  ONLINE
  HYBRID

  @@map("OppotunityFormat")
}

enum AcademicLevel {
  FIRST_YEAR
  SECOND_YEAR
  MASTER
  PHD
}

enum Interests {
  HACKATHONS
  AI_DATA
  STARTUPS_ENTR
  ROBOTICS_IOT
  UI_UX_DESIGN
  PUBLIC_SPEAKING
  SOCIAL_IMPACT_NGOS
  FINTECH
  SCIENTIFIC_RESEARCH
  CAREER_FAIRS_NETWORKING
}

enum OrganizationType {
  UNIVERSITY
  STUDENT_CLUB
  NGO
  ASSOCIATION
  COMPANY
  COMMUNITY
  OTHER
}

enum VerificationStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

enum RegistrationMode {
  AUTOMATIC
  EXTERNAL
}

enum NotificationType {
  ORGANIZATION_APPROVED
  ORGANIZATION_REJECTED
  ORGANIZATION_NEEDS_CHANGES
  EVENT_PUBLISHED
  EVENT_UPDATED
  EVENT_CANCELLED
  REGISTRATION_PENDING
  REGISTRATION_CONFIRMED
  REGISTRATION_REJECTED
  REGISTRATION_CANCELLED
  REGISTRATION_REMINDER
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  lastName        String     @map("last_name") @db.VarChar(100)
  firstName       String     @map("first_name") @db.VarChar(100)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  role            UserRole
  status          UserStatus
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamp(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  studentProfilesByUser                 StudentProfile?           @relation("StudentProfileUserId")
  organizationsByOwner                  Organization[]            @relation("OrganizationOwnerId")
  organizationsByVerifiedBy             Organization[]            @relation("OrganizationVerifiedById")
  organizationApplicationsBySubmittedBy OrganizationApplication[] @relation("OrganizationApplicationSubmittedById")
  organizationApplicationsByReviewer    OrganizationApplication[] @relation("OrganizationApplicationReviewerId")
  eventsByCreatedBy                     Event[]                   @relation("EventCreatedById")
  studentInterestsByStudent             StudentInterest[]         @relation("StudentInterestStudentId")
  eventRegistrationsByStudent           EventRegistration[]       @relation("EventRegistrationStudentId")
  eventRegistrationsByReviewedBy        EventRegistration[]       @relation("EventRegistrationReviewedById")
  notificationsByUser                   Notification[]            @relation("NotificationUserId")
  organizationFollowsByFollower         OrganizationFollow[]      @relation("OrganizationFollowFollowerId")

  @@map("users")
}

model StudentProfile {
  userId            String             @id @map("user_id") @db.Uuid
  university        String?            @db.VarChar(255)
  academicField     AcademicField?     @map("academic_field")
  studyLevel        AcademicLevel?     @map("study_level")
  interests         Interests?
  opportunityFormat OpportunityFormat? @map("opportunity_format")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation("StudentProfileUserId", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("student_profiles")
}

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  ownerId                String             @map("owner_id") @db.Uuid
  orgName                String             @map("org_name") @db.VarChar(255)
  type                   OrganizationType
  representativeFullName String             @map("representative_FullName") @db.VarChar(255)
  academicPosition       String             @map("academic_position") @db.VarChar(255)
  proofUrl               String?            @map("proof_url") @db.VarChar(512)
  phoneNumber            String             @map("phone_number") @db.VarChar(255)
  verificationStatus     VerificationStatus @map("verification_status")
  verifiedAt             DateTime?          @map("verified_at") @db.Timestamp(6)
  verifiedById           String?            @map("verified_by_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  owner                                  User                      @relation("OrganizationOwnerId", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedBy                             User?                     @relation("OrganizationVerifiedById", fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationApplicationsByOrganization OrganizationApplication[] @relation("OrganizationApplicationOrganizationId")
  eventsByOrganization                   Event[]                   @relation("EventOrganizationId")
  notificationsByOrganization            Notification[]            @relation("NotificationOrganizationId")
  organizationFollowsByOrganization      OrganizationFollow[]      @relation("OrganizationFollowOrganizationId")

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationApplication {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  submittedById  String             @map("submitted_by_id") @db.Uuid
  reviewerId     String?            @map("reviewer_id") @db.Uuid
  status         VerificationStatus
  reviewerNote   String?            @map("reviewer_note") @db.Text
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamp(6)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamp(6)

  organization Organization @relation("OrganizationApplicationOrganizationId", fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submittedBy  User         @relation("OrganizationApplicationSubmittedById", fields: [submittedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer     User?        @relation("OrganizationApplicationReviewerId", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([submittedById])
  @@index([reviewerId])
  @@map("organization_applications")
}

model Event {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  createdById             String           @map("created_by_id") @db.Uuid
  title                   String           @db.VarChar(255)
  description             String           @db.Text
  format                  EventFormat
  location                String?          @db.VarChar(500)
  onlineUrl               String?          @map("online_url") @db.VarChar(500)
  imageUrl                String?          @map("image_url") @db.VarChar(500)
  startDate               DateTime         @map("start_date") @db.Timestamp(6)
  endDate                 DateTime         @map("end_date") @db.Timestamp(6)
  registrationDeadline    DateTime?        @map("registration_deadline") @db.Timestamp(6)
  capacity                Int?
  registrationMode        RegistrationMode @map("registration_mode")
  externalRegistrationUrl String?          @map("external_registration_url") @db.VarChar(500)
  status                  EventStatus
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  organization              Organization        @relation("EventOrganizationId", fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy                 User                @relation("EventCreatedById", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventCategoriesByEvent    EventCategory[]     @relation("EventCategoryEventId")
  eventRegistrationsByEvent EventRegistration[] @relation("EventRegistrationEventId")
  notificationsByEvent      Notification[]      @relation("NotificationEventId")

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([registrationDeadline])
  @@map("events")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  eventCategoriesByCategory  EventCategory[]   @relation("EventCategoryCategoryId")
  studentInterestsByCategory StudentInterest[] @relation("StudentInterestCategoryId")

  @@map("categories")
}

model EventCategory {
  eventId    String @map("event_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  event    Event    @relation("EventCategoryEventId", fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category Category @relation("EventCategoryCategoryId", fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([eventId, categoryId])
  @@map("event_categories")
}

model StudentInterest {
  studentId  String   @map("student_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  student  User     @relation("StudentInterestStudentId", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category Category @relation("StudentInterestCategoryId", fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([studentId, categoryId])
  @@map("student_interests")
}

model EventRegistration {
  id                 String             @id @default(uuid()) @db.Uuid
  eventId            String             @map("event_id") @db.Uuid
  studentId          String             @map("student_id") @db.Uuid
  status             RegistrationStatus
  registeredAt       DateTime           @default(now()) @map("registered_at") @db.Timestamp(6)
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamp(6)
  reviewedById       String?            @map("reviewed_by_id") @db.Uuid
  cancellationReason String?            @map("cancellation_reason") @db.Text
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  student    User  @relation("EventRegistrationStudentId", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event      Event @relation("EventRegistrationEventId", fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy User? @relation("EventRegistrationReviewedById", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, eventId])
  @@index([eventId])
  @@index([studentId])
  @@index([status])
  @@map("event_registrations")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String           @db.Text
  eventId        String?          @map("event_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  isRead         Boolean          @map("is_read")
  readAt         DateTime?        @map("read_at") @db.Timestamp(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  user         User          @relation("NotificationUserId", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event        Event?        @relation("NotificationEventId", fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization? @relation("NotificationOrganizationId", fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([eventId])
  @@index([organizationId])
  @@index([isRead])
  @@map("notifications")
}

model OrganizationFollow {
  followerId     String   @map("follower_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  follower     User         @relation("OrganizationFollowFollowerId", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization Organization @relation("OrganizationFollowOrganizationId", fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([followerId, organizationId])
  @@map("organization_follows")
}
