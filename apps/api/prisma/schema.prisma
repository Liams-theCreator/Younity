// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ORGANIZER
}

enum OpportunityFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum StudyLevel {
  FIRST_YEAR
  SECOND_YEAR
  MASTER
  PHD
}

enum AcademicField {
  COMPUTER_SCIENCE
  BUSINESS_MGMT
  ENGINEERING_ROBOTICS
  HEALTHCARE_BIOTECH
  ARTS_DESIGN
  LAW_SOCIAL_SCIENCES
  ENVIRONMENT_ARGO
}

enum Interests {
  HACKATHONS
  AI_DATA
  STARTUPS_ENTR
  ROBOTICS_IOT
  UI_UX_DESIGN
  PUBLIC_SPEAKING
  SOCIAL_IMPACT_NGOS
  FINTECH
  SCIENTIFIC_RESEARCH
  CAREER_FAIRS_NETWORKING
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationType {
  UNIVERSITY
  STUDENT_CLUB
  NGO
  ASSOCIATION
  COMPANY
  COMMUNITY
  OTHER
}

enum VerificationStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  lastName        String     @map("last_name") @db.VarChar(100)
  firstName       String     @map("first_name") @db.VarChar(100)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  role            Role
  status          UserStatus
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamp(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  student               StudentProfile?
  ownedOrganizations    Organization[]  @relation("OrganizationOwner")
  verifiedOrganizations Organization[]  @relation("OrganizationVerifier")

  @@map("users")
}

model StudentProfile {
  userId            String             @id @map("user_id") @db.Uuid
  university        String?            @db.VarChar(255)
  academicField     AcademicField?     @map("academic_field")
  studyLevel        StudyLevel?        @map("study_level")
  interests         Interests?
  opportunityFormat OpportunityFormat? @map("opportunity_format")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  ownerId                String             @map("owner_id") @db.Uuid
  orgName                String             @map("org_name") @db.VarChar(255)
  type                   OrganizationType
  representativeFullName String             @map("representative_FullName") @db.VarChar(255)
  academicPosition       String             @map("academic_position") @db.VarChar(255)
  proofUrl               String?            @map("proof_url") @db.VarChar(512)
  phoneNumber            String             @map("phone_number") @db.VarChar(255)
  verificationStatus     VerificationStatus @map("verification_status")
  verifiedAt             DateTime?          @map("verified_at") @db.Timestamp(6)
  verifiedById           String?            @map("verified_by_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  owner      User  @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("OrganizationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("organizations")
}
